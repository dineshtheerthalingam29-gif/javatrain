import java.time.LocalDateTime;
import java.time.format.DateTimeFormatter;
import java.util.*;

/**
 * A simple simulated Email System.
 * Run: javac EmailSystem.java && java EmailSystem
 */


/** Represents a single email message. */
class Email {
    private static int idCounter = 1000;

    private final int id;
    private final String from;
    private final List<String> to;
    private final String subject;
    private final String body;
    private final LocalDateTime timestamp;
    private boolean read;

    private static final DateTimeFormatter FORMATTER =
            DateTimeFormatter.ofPattern("yyyy-MM-dd HH:mm:ss");

    public Email(String from, List<String> to, String subject, String body) {
        this.id = idCounter++;
        this.from = from;
        this.to = new ArrayList<>(to);
        this.subject = subject;
        this.body = body;
        this.timestamp = LocalDateTime.now();
        this.read = false;
    }

    public int getId() { return id; }
    public String getFrom() { return from; }
    public List<String> getTo() { return to; }
    public String getSubject() { return subject; }
    public String getBody() { return body; }
    public boolean isRead() { return read; }
    public void markAsRead() { this.read = true; }

    public String getSummary() {
        return String.format("[%d] %s From: %-18s Subject: %s (%s)",
                id, read ? "  " : "*", from, subject,
                timestamp.format(FORMATTER));
    }

    public void printFull() {
        System.out.println("ID:      " + id);
        System.out.println("From:    " + from);
        System.out.println("To:      " + String.join(", ", to));
        System.out.println("Subject: " + subject);
        System.out.println("Date:    " + timestamp.format(FORMATTER));
        System.out.println("Read:    " + read);
        System.out.println("---");
        System.out.println(body);
    }
}

/** Holds a user's inbox and sent items. */
class Mailbox {
    private final List<Email> inbox = new ArrayList<>();
    private final List<Email> sent = new ArrayList<>();

    public void receive(Email email) { inbox.add(email); }
    public void recordSent(Email email) { sent.add(email); }

    public List<Email> getInbox() { return inbox; }
    public List<Email> getSent() { return sent; }

    public long unreadCount() {
        return inbox.stream().filter(e -> !e.isRead()).count();
    }
}

/** Represents a registered user of the system. */
class User {
    private final String username;
    private final String email;

    public User(String username, String email) {
        this.username = username;
        this.email = email;
    }

    public String getUsername() { return username; }
    public String getEmail() { return email; }
}

/** Central server: manages users and routes emails between mailboxes. */
class EmailServer {
    private final Map<String, User> users = new HashMap<>();       // email -> User
    private final Map<String, Mailbox> mailboxes = new HashMap<>(); // email -> Mailbox

    public void registerUser(String username, String email) {
        if (users.containsKey(email)) {
            System.out.println("User already exists: " + email);
            return;
        }
        users.put(email, new User(username, email));
        mailboxes.put(email, new Mailbox());
        System.out.println("Registered: " + username + " <" + email + ">");
    }

    public void sendEmail(String from, String to, String subject, String body) {
        sendEmail(from, Collections.singletonList(to), subject, body);
    }

    public void sendEmail(String from, List<String> to, String subject, String body) {
        if (!users.containsKey(from)) {
            System.out.println("Send failed: sender not registered - " + from);
            return;
        }

        List<String> validRecipients = new ArrayList<>();
        for (String recipient : to) {
            if (users.containsKey(recipient)) {
                validRecipients.add(recipient);
            } else {
                System.out.println("Warning: recipient not registered - " + recipient);
            }
        }
        if (validRecipients.isEmpty()) {
            System.out.println("Send failed: no valid recipients.");
            return;
        }

        Email email = new Email(from, validRecipients, subject, body);

        // Deliver to each recipient's inbox
        for (String recipient : validRecipients) {
            mailboxes.get(recipient).receive(email);
        }
        // Record in sender's sent folder
        mailboxes.get(from).recordSent(email);
    }

    public List<Email> getInbox(String email) {
        Mailbox mb = mailboxes.get(email);
        return mb == null ? Collections.emptyList() : mb.getInbox();
    }

    public List<Email> getSent(String email) {
        Mailbox mb = mailboxes.get(email);
        return mb == null ? Collections.emptyList() : mb.getSent();
    }

    public void printInbox(String email) {
        List<Email> inbox = getInbox(email);
        if (inbox.isEmpty()) {
            System.out.println("(empty)");
            return;
        }
        for (Email e : inbox) {
            System.out.println(e.getSummary());
        }
    }

    public void printSent(String email) {
        List<Email> sent = getSent(email);
        if (sent.isEmpty()) {
            System.out.println("(empty)");
            return;
        }
        for (Email e : sent) {
            System.out.println(e.getSummary());
        }
    }

    public List<Email> searchInbox(String email, String keyword) {
        List<Email> results = new ArrayList<>();
        String lowerKeyword = keyword.toLowerCase();
        for (Email e : getInbox(email)) {
            if (e.getSubject().toLowerCase().contains(lowerKeyword)
                    || e.getBody().toLowerCase().contains(lowerKeyword)) {
                results.add(e);
            }
        }
        return results;
    }
}